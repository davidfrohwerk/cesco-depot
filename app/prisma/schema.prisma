generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  REGISTERED
  IN_TRANSIT_TO_DEPOT
  RECEIVED
  INSPECTION
  REPAIR
  TESTING
  READY
  DELIVERED
  STOCKED
  DISPATCHED
  INSTALLED
  DECOMMISSIONED
  DISPOSITION_REVIEW
  DONATION_OFFERED
  TITLE_TRANSFERRED
  REFURBISHED
  HARVESTED
  RECYCLED
  RETIRED
}

enum WorkOrderStatus {
  IN_TRANSIT
  AWAITING_RECEIPT
  RECEIVED
  INTAKE
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  WAITING_CUSTOMER_AUTHORIZATION
  WAITING_EXTERNAL_SERVICE
  TESTING
  READY
  PACKED
  OUTBOUND
  COMPLETED
  CANCELLED
}

enum OrganizationKind {
  INTERNAL
  CLIENT
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ServiceRequestStatus {
  DRAFT
  PENDING_AUTHORIZATION
  AUTHORIZED
  SHIPMENT_PREPARING
  IN_TRANSIT
  RECEIVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ServiceType {
  DIAGNOSE
  REPAIR
  TEST
  RECONFIGURE
  STRATEGIC_STOCK
  REDEPLOY
  SHIP_ELSEWHERE
  DECOMMISSION
  DATA_DESTRUCTION
  DONATE
  RECYCLE
  OTHER
}

enum AuthorizationStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
  REVOKED
}

enum ShipmentDirection {
  INBOUND
  OUTBOUND
  TRANSFER
}

enum ShipmentStatus {
  PREPARING
  LABEL_CREATED
  TRACKING_ENTERED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum PackageStatus {
  EXPECTED
  IN_TRANSIT
  RECEIVED
  DELIVERED
  OPENED
  RECONCILED
  EXCEPTION
}

enum EndpointType {
  STORE
  CLINIC
  BRANCH
  RESTAURANT
  WAREHOUSE
  OFFICE
  DATA_CENTER
  OTHER
}

enum ServiceLocationType {
  DEPOT
  STORAGE_UNIT
  WAREHOUSE
  PARTNER_FACILITY
  CROSS_DOCK
  TECHNICIAN_STAGING
  OTHER
}

enum StorageLocationType {
  RECEIVING
  CAGE
  ROOM
  RACK
  SHELF
  BIN
  PALLET_POSITION
  BENCH
  FLOOR_POSITION
  OTHER
}

enum CustodyType {
  CUSTOMER
  CARRIER
  CESCO
  FIELD_TECHNICIAN
  PARTNER
  RECYCLER
  OTHER
}

enum ReceiptCondition {
  UNKNOWN
  GOOD
  DAMAGED
  TAMPERED
  WET
  CRUSHED
  OPEN
  OTHER
}

enum AssetCondition {
  UNKNOWN
  GOOD
  KNOWN_GOOD
  COSMETIC_DAMAGE
  SHIPPING_DAMAGE
  FAILED
  INTERMITTENT
  REPAIRABLE
  NONREPAIRABLE
  PARTS_ONLY
  DATA_BEARING
  TEST_PENDING
}

enum WorkActivityType {
  RECEIVING
  INVENTORY_INTAKE
  INSPECTION
  DIAGNOSIS
  REPAIR
  TESTING
  CONFIGURATION
  PACKAGING
  LOGISTICS
  DATA_DESTRUCTION
  DECOMMISSIONING
  ADMINISTRATION
  TRAINING
  SUPERVISION
  OTHER
}

enum WorkOrderPartStatus {
  REQUIRED
  ORDERED
  BACKORDERED
  RECEIVED
  INSTALLED
  REMOVED
  RETURNED
  CONSUMED
  CANCELLED
}

enum EvidenceType {
  PACKAGE_EXTERIOR
  SHIPPING_LABEL
  DAMAGE
  SERIAL_ASSET_TAG
  BEFORE_REPAIR
  AFTER_REPAIR
  TEST_RESULT
  PACKING
  OUTBOUND_SHIPMENT
  SIGNED_AUTHORIZATION
  TITLE_TRANSFER
  DATA_DESTRUCTION_CERTIFICATE
  OTHER
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName  String?
  passwordHash String?
  lastLoginAt  DateTime?
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions          AuthSession[]
  receivedInvites   UserInvite[] @relation("InvitedUser")
  createdInvites    UserInvite[] @relation("InviteCreator")
  memberships       Membership[]
  requestedServices ServiceRequest[] @relation("ServiceRequestedBy")
  authorizations    Authorization[]  @relation("AuthorizationApprovedBy")
  receivedPackages     Receipt[]          @relation("ReceiptReceivedBy")
  workOrderEvents      WorkOrderEvent[]   @relation("WorkOrderEventActor")
  workActivities       WorkActivity[]     @relation("WorkActivityWorker")
  supervisedActivities WorkActivity[]     @relation("WorkActivitySupervisor")
  assetObservations    AssetObservation[] @relation("AssetObservationObserver")
  uploadedEvidence     Evidence[]         @relation("EvidenceUploader")
  evidenceAccessEvents EvidenceAccessEvent[] @relation("EvidenceAccessActor")
}

model UserInvite {
  id              String   @id @default(cuid())
  userId          String
  membershipId    String
  createdByUserId String
  tokenHash       String   @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())

  user       User       @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("InviteCreator", fields: [createdByUserId], references: [id])

  @@index([userId])
  @@index([membershipId])
  @@index([createdByUserId])
  @@index([expiresAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  kind      OrganizationKind @default(CLIENT)
  createdAt DateTime         @default(now())
  updatedAt DateTime @updatedAt

  sites           Site[]
  endpoints       Endpoint[]
  managedServiceLocations ServiceLocation[] @relation("ServiceLocationManager")
  serviceLocationAccess ServiceLocationClient[]
  dedicatedStoragePositions StoragePosition[] @relation("StoragePositionDedicatedOrganization")
  assets          Asset[]          @relation("AssetAccountOrganization")
  ownedAssets     Asset[]          @relation("AssetOwnerOrganization")
  memberships     Membership[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]
  evidence        Evidence[]
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  roles        MembershipRole[]
  invites      UserInvite[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships MembershipRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model MembershipRole {
  membershipId String
  roleId       String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Endpoint {
  id             String       @id @default(cuid())
  organizationId String
  externalCode   String?
  name           String
  type           EndpointType @default(OTHER)
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String       @default("US")
  region         String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  isActive       Boolean      @default(true)
  serviceNotes   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  currentAssets Asset[]      @relation("AssetCurrentEndpoint")

  @@unique([organizationId, externalCode])
  @@index([organizationId])
  @@index([isActive])
}

model ServiceLocation {
  id                      String              @id @default(cuid())
  managedByOrganizationId String?
  code                    String?             @unique
  name                    String
  type                    ServiceLocationType
  operatorLabel           String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String              @default("US")
  region                  String?
  climateControlled       Boolean             @default(false)
  secureStorage           Boolean             @default(false)
  accessInstructions      String?
  capabilities            String?
  notes                   String?
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  managedByOrganization Organization?          @relation("ServiceLocationManager", fields: [managedByOrganizationId], references: [id])
  positions             StoragePosition[]
  clientAccess          ServiceLocationClient[]

  @@index([managedByOrganizationId])
  @@index([type])
  @@index([isActive])
}

model ServiceLocationClient {
  serviceLocationId String
  organizationId    String
  notes             String?
  createdAt         DateTime @default(now())

  serviceLocation ServiceLocation @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([serviceLocationId, organizationId])
  @@index([organizationId])
}

model StoragePosition {
  id                      String              @id @default(cuid())
  serviceLocationId       String
  parentId                String?
  dedicatedOrganizationId String?
  name                    String
  code                    String?
  type                    StorageLocationType
  isActive                Boolean             @default(true)
  capacity                Int?
  capacityUnit            String?
  secureStorage           Boolean             @default(false)
  environmentalNotes      String?
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  serviceLocation       ServiceLocation  @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)
  parent                StoragePosition? @relation("StoragePositionTree", fields: [parentId], references: [id])
  children              StoragePosition[] @relation("StoragePositionTree")
  dedicatedOrganization Organization?    @relation("StoragePositionDedicatedOrganization", fields: [dedicatedOrganizationId], references: [id])
  currentAssets         Asset[]          @relation("AssetCurrentStoragePosition")

  @@unique([serviceLocationId, code])
  @@index([serviceLocationId])
  @@index([parentId])
  @@index([dedicatedOrganizationId])
}

model Site {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String   @default("US")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization      @relation(fields: [organizationId], references: [id])
  assets               Asset[]
  storageLocations     StorageLocation[]
  destinationShipments Shipment[]        @relation("ShipmentDestinationSite")
  originShipments      Shipment[]        @relation("ShipmentOriginSite")

  @@index([organizationId])
}

model StorageLocation {
  id                      String              @id @default(cuid())
  siteId                  String
  parentId                String?
  name                    String
  code                    String?
  type                    StorageLocationType
  isActive                Boolean             @default(true)
  capacity                Int?
  capacityUnit            String?
  secureStorage           Boolean             @default(false)
  environmentalNotes      String?
  dedicatedOrganizationId String?
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  site          Site              @relation(fields: [siteId], references: [id])
  parent        StorageLocation?  @relation("StorageLocationTree", fields: [parentId], references: [id])
  children      StorageLocation[] @relation("StorageLocationTree")
  currentAssets Asset[]           @relation("AssetCurrentStorageLocation")
  receipts      Receipt[]

  @@unique([siteId, code])
  @@index([siteId])
  @@index([parentId])
}

model Asset {
  id                       String       @id @default(cuid())
  assetTag                 String       @unique
  organizationId           String
  ownerOrganizationId      String?
  siteId                   String?
  currentStorageLocationId String?
  currentEndpointId        String?
  currentStoragePositionId String?
  currentCustodyType       CustodyType?
  currentCustodianLabel    String?
  manufacturer             String?
  model                    String?
  serialNumber             String?
  status                   AssetStatus  @default(REGISTERED)
  description              String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  organization           Organization     @relation("AssetAccountOrganization", fields: [organizationId], references: [id])
  ownerOrganization      Organization?    @relation("AssetOwnerOrganization", fields: [ownerOrganizationId], references: [id])
  site                   Site?            @relation(fields: [siteId], references: [id])
  currentStorageLocation StorageLocation? @relation("AssetCurrentStorageLocation", fields: [currentStorageLocationId], references: [id])
  currentEndpoint        Endpoint?        @relation("AssetCurrentEndpoint", fields: [currentEndpointId], references: [id])
  currentStoragePosition StoragePosition? @relation("AssetCurrentStoragePosition", fields: [currentStoragePositionId], references: [id])
  events                 AssetEvent[]
  workOrders             WorkOrder[]
  serviceRequests        ServiceRequest[]
  packageContents        PackageContent[]
  observations           AssetObservation[]
  evidence               Evidence[]

  @@index([serialNumber])
  @@index([organizationId])
  @@index([ownerOrganizationId])
  @@index([currentStorageLocationId])
  @@index([currentEndpointId])
  @@index([currentStoragePositionId])
  @@index([status])
}

model AssetEvent {
  id         String       @id @default(cuid())
  assetId    String
  eventType  String
  fromStatus AssetStatus?
  toStatus   AssetStatus?
  notes      String?
  actor      String?
  createdAt  DateTime     @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
}

model ServiceRequest {
  id                String               @id @default(cuid())
  organizationId    String
  assetId           String?
  requestedByUserId String?
  serviceType       ServiceType
  status            ServiceRequestStatus @default(DRAFT)
  priority          String?
  customerNotes     String?
  requestedOutcome  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id])
  asset           Asset?          @relation(fields: [assetId], references: [id])
  requestedByUser User?           @relation("ServiceRequestedBy", fields: [requestedByUserId], references: [id])
  authorizations  Authorization[]
  shipments       Shipment[]
  workOrders      WorkOrder[]

  @@index([organizationId])
  @@index([assetId])
  @@index([status])
}

model Authorization {
  id                 String              @id @default(cuid())
  serviceRequestId   String
  authorizedByUserId String?
  status             AuthorizationStatus @default(PENDING)
  scope              String
  spendingLimitCents Int?
  currency           String              @default("USD")
  termsVersion       String?
  authorizedAt       DateTime?
  expiresAt          DateTime?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  authorizedByUser User?          @relation("AuthorizationApprovedBy", fields: [authorizedByUserId], references: [id])
  evidence         Evidence[]

  @@index([serviceRequestId])
  @@index([status])
}

model Shipment {
  id                String            @id @default(cuid())
  serviceRequestId  String
  direction         ShipmentDirection @default(INBOUND)
  originSiteId      String?
  destinationSiteId String
  carrier           String?
  trackingNumber    String?
  status            ShipmentStatus    @default(PREPARING)
  labelReference    String?
  shippedAt         DateTime?
  acceptedAt        DateTime?
  expectedAt        DateTime?
  deliveredAt                 DateTime?
  customerAcknowledgedAt       DateTime?
  customerAcknowledgedByLabel  String?
  customerAcknowledgmentNotes  String?
  createdAt                   DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  serviceRequest  ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  originSite      Site?          @relation("ShipmentOriginSite", fields: [originSiteId], references: [id])
  destinationSite Site           @relation("ShipmentDestinationSite", fields: [destinationSiteId], references: [id])
  packages        Package[]
  workOrders      WorkOrder[]
  evidence        Evidence[]

  @@index([serviceRequestId])
  @@index([direction])
  @@index([originSiteId])
  @@index([destinationSiteId])
  @@index([trackingNumber])
  @@index([status])
}

model Package {
  id             String        @id @default(cuid())
  shipmentId     String
  packageCode    String?
  trackingNumber String?
  status         PackageStatus @default(EXPECTED)
  weightGrams    Int?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  shipment Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  contents PackageContent[]
  receipt  Receipt?
  evidence Evidence[]

  @@index([shipmentId])
  @@index([trackingNumber])
}

model PackageContent {
  id          String   @id @default(cuid())
  packageId   String
  assetId     String?
  description String?
  quantity    Int      @default(1)
  expected    Boolean  @default(true)
  createdAt   DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  asset   Asset?  @relation(fields: [assetId], references: [id])

  @@index([packageId])
  @@index([assetId])
}

model Receipt {
  id                String           @id @default(cuid())
  packageId         String           @unique
  receivedByUserId  String?
  storageLocationId String?
  receivedAt        DateTime         @default(now())
  condition         ReceiptCondition @default(UNKNOWN)
  sealIntact        Boolean?
  notes             String?
  createdAt         DateTime         @default(now())

  package         Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  receivedByUser  User?            @relation("ReceiptReceivedBy", fields: [receivedByUserId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  evidence        Evidence[]

  @@index([receivedByUserId])
  @@index([storageLocationId])
}

model WorkOrder {
  id               String          @id @default(cuid())
  assetId          String
  organizationId   String?
  serviceRequestId String?
  shipmentId       String?
  number           String          @unique
  status           WorkOrderStatus @default(OPEN)
  serviceType      ServiceType?
  reportedIssue    String?
  diagnosis        String?
  resolution       String?
  openedAt         DateTime        @default(now())
  completedAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  asset          Asset           @relation(fields: [assetId], references: [id])
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  shipment       Shipment?       @relation(fields: [shipmentId], references: [id])
  events         WorkOrderEvent[]
  activities     WorkActivity[]
  parts          WorkOrderPart[]
  observations   AssetObservation[]
  evidence       Evidence[]

  @@index([assetId])
  @@index([organizationId])
  @@index([serviceRequestId])
  @@index([shipmentId])
  @@index([status])
}


model WorkOrderEvent {
  id              String           @id @default(cuid())
  workOrderId     String
  actorUserId     String?
  eventType       String
  fromStatus      WorkOrderStatus?
  toStatus        WorkOrderStatus?
  notes           String?
  actorLabel      String?
  systemGenerated Boolean          @default(false)
  createdAt       DateTime         @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation("WorkOrderEventActor", fields: [actorUserId], references: [id])
  evidence  Evidence[]

  @@index([workOrderId, createdAt])
  @@index([actorUserId])
  @@index([eventType])
}

model WorkActivity {
  id               String           @id @default(cuid())
  workOrderId      String
  workerUserId     String?
  supervisorUserId String?
  workerLabel      String?
  activityType     WorkActivityType
  startedAt        DateTime
  endedAt          DateTime?
  durationMinutes  Int?
  notes            String?
  billable         Boolean          @default(false)
  training         Boolean          @default(false)
  supervised       Boolean          @default(false)
  verified         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  worker     User?     @relation("WorkActivityWorker", fields: [workerUserId], references: [id])
  supervisor User?     @relation("WorkActivitySupervisor", fields: [supervisorUserId], references: [id])

  @@index([workOrderId, startedAt])
  @@index([workerUserId])
  @@index([activityType])
}

model AssetObservation {
  id             String         @id @default(cuid())
  assetId        String
  workOrderId    String?
  observerUserId String?
  observerLabel  String?
  observationType String?
  condition      AssetCondition
  notes          String?
  observedAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())

  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrder  WorkOrder? @relation(fields: [workOrderId], references: [id])
  observer   User?      @relation("AssetObservationObserver", fields: [observerUserId], references: [id])

  @@index([assetId, observedAt])
  @@index([workOrderId])
  @@index([condition])
}

model WorkOrderPart {
  id          String              @id @default(cuid())
  workOrderId String
  partNumber  String?
  description String
  manufacturer String?
  quantity    Int                 @default(1)
  unitCostCents Int?
  currency    String              @default("USD")
  source      String?
  status      WorkOrderPartStatus @default(REQUIRED)
  orderedAt   DateTime?
  receivedAt  DateTime?
  installedAt DateTime?
  removedAt   DateTime?
  returnReference String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([status])
  @@index([partNumber])
}

model Evidence {
  id              String       @id @default(cuid())
  organizationId  String
  assetId         String?
  workOrderId     String?
  workOrderEventId String?
  packageId       String?
  receiptId       String?
  authorizationId String?
  shipmentId      String?
  uploaderUserId  String?
  evidenceType    EvidenceType
  description     String?
  originalFilename String?
  mimeType        String?
  sizeBytes       Int?
  storageKey      String?
  sha256          String?
  capturedAt      DateTime?
  uploadedAt      DateTime     @default(now())
  isOriginal      Boolean      @default(true)

  organization  Organization   @relation(fields: [organizationId], references: [id])
  asset         Asset?         @relation(fields: [assetId], references: [id])
  workOrder     WorkOrder?     @relation(fields: [workOrderId], references: [id])
  workOrderEvent WorkOrderEvent? @relation(fields: [workOrderEventId], references: [id])
  package       Package?       @relation(fields: [packageId], references: [id])
  receipt       Receipt?       @relation(fields: [receiptId], references: [id])
  authorization Authorization? @relation(fields: [authorizationId], references: [id])
  shipment      Shipment?      @relation(fields: [shipmentId], references: [id])
  uploader      User?          @relation("EvidenceUploader", fields: [uploaderUserId], references: [id])
  accessEvents  EvidenceAccessEvent[]

  @@index([organizationId])
  @@index([assetId])
  @@index([workOrderId])
  @@index([workOrderEventId])
  @@index([packageId])
  @@index([receiptId])
  @@index([authorizationId])
  @@index([shipmentId])
  @@index([evidenceType])
}


model EvidenceAccessEvent {
  id                String   @id @default(cuid())
  evidenceId        String
  actorUserId       String
  action            String   @default("DOWNLOAD")
  integrityVerified Boolean  @default(true)
  accessedAt        DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  actor    User     @relation("EvidenceAccessActor", fields: [actorUserId], references: [id])

  @@index([evidenceId, accessedAt])
  @@index([actorUserId, accessedAt])
  @@index([action])
}
