# Isolated rebuild. Never reuse DATABASE_URL implicitly.
# PostgreSQL is recommended on the Azure VM; use a separate database.
# DEPOT_DATABASE_URL=postgresql://depot_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/depot_v2

# SQLite fallback for a single local development process.
DEPOT_DATABASE_PATH=data/depot-v2.sqlite
DEPOT_EVIDENCE_PATH=data/evidence
DEPOT_ORIGIN=http://127.0.0.1:3000

# Bootstrap admin credentials are read from the process environment.
# Do not keep DEPOT_ADMIN_PASSWORD in a committed file.
